{
  "name": "fly-machine-rotator",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "patch:spmt-llm": "node scripts/patch-spmt-local-llm.mjs",
    "patch:workspace-parity": "node scripts/patch-ecosystem-workspace-parity.mjs && node scripts/patch-mountainview-command-parity.mjs",
    "prebuild": "npm run patch:spmt-llm && npm run patch:workspace-parity",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js run",
    "monitor": "node dist/index.js monitor",
    "predev": "npm run patch:spmt-llm && npm run patch:workspace-parity",
    "dev": "tsx src/index.ts run",
    "dry-run": "tsx src/index.ts run --dry-run",
    "athena": "node scripts/athena-code.mjs",
    "pretest": "npm run patch:spmt-llm && npm run patch:workspace-parity",
    "test": "vitest run",
    "pretypecheck": "npm run patch:spmt-llm && npm run patch:workspace-parity",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@openai/codex-sdk": "^0.146.0",
    "better-sqlite3": "^12.11.1",
    "nats": "^2.29.3",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.18",
    "@types/qrcode": "^1.5.4",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.3"
  },
  "engines": {
    "node": ">=20"
  }
}
